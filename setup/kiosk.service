[Unit]
Description=Scrapper Kiosk UI (Kivy en HDMI0)
After=systemd-user-sessions.service network-online.target
Wants=network-online.target
Conflicts=getty@tty1.service

[Service]
User=__USER__
WorkingDirectory=__PROJECT_DIR__
# Lanza el servidor X con la UI como único cliente (sin gestor de ventanas), en tty1.
ExecStart=/usr/bin/startx -- vt1 -nocursor
Restart=always
RestartSec=3
# La UI necesita una TTY para que startx tome el control del vídeo.
TTYPath=/dev/tty1
StandardInput=tty
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
