[Unit]
Description=Scrapper Kiosk (labwc/Wayland) en HDMI0 + vídeo en HDMI1
After=systemd-user-sessions.service network-online.target
Wants=network-online.target
Conflicts=getty@tty1.service

[Service]
User=__USER__
PAMName=login
WorkingDirectory=__PROJECT_DIR__
TTYPath=/dev/tty1
# labwc arranca el compositor Wayland; su autostart lanza la UI Kivy.
ExecStart=/usr/bin/labwc
Restart=always
RestartSec=3
# Entorno mínimo necesario para una sesión Wayland en tty1.
Environment=XDG_RUNTIME_DIR=/run/user/__UID__
Environment=XDG_SESSION_TYPE=wayland
StandardInput=tty
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
