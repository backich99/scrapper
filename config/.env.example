# Plantilla de variables de entorno para Scrapper.
# Copia este fichero a config/.env y rellena los valores reales.
# config/.env NO se versiona (está en .gitignore).

# User-Agent usado por el scraper para las peticiones HTTP.
SCRAPPER_USER_AGENT="Mozilla/5.0 (X11; Linux aarch64) Scrapper/1.0"

# Índice de pantalla para mpv (HDMI1 = la TV de 65").
# Ajusta si el orden de detección de pantallas es distinto.
SCRAPPER_MPV_SCREEN=1
